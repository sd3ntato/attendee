apiVersion: v1
kind: Secret
metadata:
  name: attendee-secrets
  namespace: attendee
type: Opaque
stringData:
  # Django settings
  DJANGO_SECRET_KEY: "<REPLACE_WITH_DJANGO_SECRET_KEY>"
  CREDENTIALS_ENCRYPTION_KEY: "<REPLACE_WITH_CREDENTIALS_ENCRYPTION_KEY>"

  # Database connection string
  # Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
  # Points to the postgres container running on the EC2 attendee instance
  DATABASE_URL: "postgresql://attendee_development_user:attendee_development_user@172.31.16.245:5432/attendee_development"
